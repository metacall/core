# Ignore Rust runtime leaks
{
    Ignore memory leaked from lang_start_internal.
    Memcheck:Leak
    ...
    fun:new_inner
    ...
}

# Ignore Rust runtime per-thread data (newer std versions)
{
    Ignore current thread handle allocated by std.
    Memcheck:Leak
    ...
    fun:_ZN3std6thread7current12init_current*
    ...
}
{
    Ignore stack overflow thread info allocated by std.
    Memcheck:Leak
    ...
    fun:_ZN3std3sys3pal4unix14stack_overflow11thread_info16set_current_info*
    ...
}

# Ignore ld leaks
{
    Ignore dynamic linker leaks.
    Memcheck:Leak
    ...
    fun:add_dependency
    fun:_dl_lookup_symbol_x
    fun:_dl_fixup
    fun:_dl_runtime_resolve_xsave
    ...
}

# Ignore leaks from loaders depenecies for now, we want to debug the port only
{
    Ignore leaks from C Loader depends Clang.
    Memcheck:Leak
    ...
    obj:*/libclang-*.so.*
}
{
    Ignore leaks from C Loader depends LLVM.
    Memcheck:Leak
    ...
    obj:*/libLLVM-*.so.*
}
{
    Ignore leaks from Python Loader depends CPython.
    Memcheck:Leak
    ...
    obj:*/libpython*.so.*
}
